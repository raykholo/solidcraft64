#!/bin/sh
# Run x64sc headless under Xvfb: vice-run [x64sc arguments...]
# (xvfb-run hangs when it is a container's PID 1, so start Xvfb ourselves.)
Xvfb :99 -screen 0 1024x768x24 -nolisten tcp >/dev/null 2>&1 &
xpid=$!
export DISPLAY=:99
i=0; while [ ! -e /tmp/.X11-unix/X99 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
x64sc -default -sounddev dummy "$@"
rc=$?
kill $xpid 2>/dev/null
exit $rc
